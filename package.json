{
  "name": "vitos-portfolio",
  "private": true,
  "version": "3.0.0",
  "description": "Personal portfolio of Vito Krawutschke: a night-lit engineering tower in three.js that you climb by scrolling.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "predev": "npm run de",
    "build": "tsc --noEmit && vite build",
    "prebuild": "npm run de",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "de": "node scripts/gen-de.mjs",
    "og": "node scripts/og.mjs",
    "posters": "node scripts/posters.mjs",
    "capture": "node scripts/capture.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.186.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "playwright": "^1.64.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
